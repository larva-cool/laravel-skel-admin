# 【测试】环境变量

# 系统名称
VITE_APP_TITLE = Laravel Skel Admin

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀（测试环境设置为完整后端地址，不走代理）
VITE_API_URL = https://skel-forge.laua.cn/

# Delete console
VITE_DROP_CONSOLE = true

# Reverb 测试环境配置
VITE_REVERB_APP_KEY = app-key
VITE_REVERB_HOST = skel-forge.laua.cn
VITE_REVERB_PORT = 443
VITE_REVERB_SCHEME = https
